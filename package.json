{
  "name": "deepseek-harness-internals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "sources:verify": "node scripts/verify-sources.mjs",
    "evidence:local": "node scripts/run-local-evidence.mjs",
    "check:analysis": "node scripts/verify-analysis.mjs",
    "check:anchors": "node scripts/verify-anchors.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:portability": "node scripts/verify-portability.mjs",
    "check:licenses": "node scripts/verify-licenses.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "test": "node --test scripts/tests/analysis-metadata.test.mjs scripts/tests/gitlink.test.mjs scripts/tests/license-hash.test.mjs scripts/tests/run-local-evidence.test.mjs",
    "check": "npm run sources:verify && npm run check:analysis && npm run check:anchors && npm run check:style && npm run check:portability && npm run check:licenses && npm run check:links && npm run check:secrets && npm test",
    "check:style": "node scripts/check-style.mjs",
    "style:report": "node scripts/check-style.mjs --report"
  }
}
